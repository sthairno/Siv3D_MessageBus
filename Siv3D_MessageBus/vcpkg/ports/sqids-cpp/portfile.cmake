vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO sqids/sqids-cpp
    REF v0.3.0
    SHA512 58FCD98FF67E43A8D6D23F16F62DF520CCA151A306055E04B6FD243AD07DAE5DAFC9A0EB7D4AD219F57C72402158EE89ED9B709B809BA87CA3579444BF697520
    HEAD_REF main
)

# Header-only: install headers only (upstream CMake unconditionally adds tests).
file(INSTALL "${SOURCE_PATH}/include/sqids" DESTINATION "${CURRENT_PACKAGES_DIR}/include")

# Handle copyright
file(INSTALL "${SOURCE_PATH}/LICENSE" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}" RENAME copyright)
